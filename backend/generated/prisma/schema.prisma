generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  correo       String   @unique
  passwordHash String
  telefono     String?
  rol          String   @default("comprador")
  creadoEn     DateTime @default(now())

  publicaciones               Publicacion[]
  busquedasGuardadas          BusquedaGuardada[]
  conversacionesComoComprador Conversacion[]     @relation("ConversacionesComoComprador")
  conversacionesComoVendedor  Conversacion[]     @relation("ConversacionesComoVendedor")
  mensajes                    Mensaje[]

  @@map("usuarios")
}

model Categoria {
  id               Int         @id @default(autoincrement())
  nombre           String
  categoriaPadreId Int?
  categoriaPadre   Categoria?  @relation("Subcategorias", fields: [categoriaPadreId], references: [id])
  subcategorias    Categoria[] @relation("Subcategorias")

  publicaciones      Publicacion[]
  busquedasGuardadas BusquedaGuardada[]

  @@map("categorias")
}

model Publicacion {
  id               Int      @id @default(autoincrement())
  vendedorId       Int
  categoriaId      Int
  titulo           String
  descripcion      String
  cantidad         Float
  unidad           String
  precio           Float
  latitud          Float
  longitud         Float
  estado           String   @default("activa")
  fechaVencimiento DateTime
  creadoEn         DateTime @default(now())

  vendedor       Usuario           @relation(fields: [vendedorId], references: [id])
  categoria      Categoria         @relation(fields: [categoriaId], references: [id])
  fotos          PublicacionFoto[]
  alertas        Alerta[]
  conversaciones Conversacion[]
  reportes       Reporte[]

  @@map("publicaciones")
}

model PublicacionFoto {
  id            Int    @id @default(autoincrement())
  publicacionId Int
  url           String
  orden         Int    @default(0)

  publicacion Publicacion @relation(fields: [publicacionId], references: [id])

  @@map("publicacion_fotos")
}

model BusquedaGuardada {
  id            Int      @id @default(autoincrement())
  compradorId   Int
  categoriaId   Int
  palabrasClave String?
  latitud       Float
  longitud      Float
  radioKm       Float
  precioMaximo  Float?
  activa        Boolean  @default(true)
  creadoEn      DateTime @default(now())

  comprador Usuario   @relation(fields: [compradorId], references: [id])
  categoria Categoria @relation(fields: [categoriaId], references: [id])
  alertas   Alerta[]

  @@map("busquedas_guardadas")
}

model Alerta {
  id            Int      @id @default(autoincrement())
  busquedaId    Int
  publicacionId Int
  leida         Boolean  @default(false)
  creadoEn      DateTime @default(now())

  busqueda    BusquedaGuardada @relation(fields: [busquedaId], references: [id])
  publicacion Publicacion      @relation(fields: [publicacionId], references: [id])

  @@map("alertas")
}

model Conversacion {
  id               Int      @id @default(autoincrement())
  publicacionId    Int
  compradorId      Int
  vendedorId       Int
  telefonoRevelado Boolean  @default(false)
  creadoEn         DateTime @default(now())

  publicacion Publicacion @relation(fields: [publicacionId], references: [id])
  comprador   Usuario     @relation("ConversacionesComoComprador", fields: [compradorId], references: [id])
  vendedor    Usuario     @relation("ConversacionesComoVendedor", fields: [vendedorId], references: [id])
  mensajes    Mensaje[]

  @@map("conversaciones")
}

model Mensaje {
  id             Int      @id @default(autoincrement())
  conversacionId Int
  emisorId       Int
  texto          String
  creadoEn       DateTime @default(now())

  conversacion Conversacion @relation(fields: [conversacionId], references: [id])
  emisor       Usuario      @relation(fields: [emisorId], references: [id])

  @@map("mensajes")
}

model Reporte {
  id            Int      @id @default(autoincrement())
  publicacionId Int
  motivo        String
  estado        String   @default("pendiente")
  creadoEn      DateTime @default(now())

  publicacion Publicacion @relation(fields: [publicacionId], references: [id])

  @@map("reportes")
}
